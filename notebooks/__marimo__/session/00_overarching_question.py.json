      "code_hash": "1002a000bf431adce52f42b0295e0b6b",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">An enzyme-engineering campaign produced a deep mutational scan, an\nenantioselectivity table, a 1.9 A crystal structure, and a set of\nengineered variants. Around it sits a small <strong>knowledge base</strong> of six\npapers. This demo runs the round-trip between all four modalities --\nand asks one question on the way:</span>\n<blockquote>\n<h4 id=\"where-do-activity-improving-mutations-of-the-enzyme-ired-88-come-from-and-could-we-have-seen-them-coming\">Where do activity-improving mutations of the enzyme IRED-88 come from -- and could we have seen them coming?</h4>\n</blockquote></span>"
          }
        }
      ],
      "console": []
    },
